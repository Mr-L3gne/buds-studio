<?xml version="1.0" encoding="UTF-8"?>
<!--
  Janela principal. Janela larga: barra lateral com os aparelhos + conteúdo. Janela estreita
  (breakpoint): coluna única, como no celular.
  Ids usados pelo código: window, split_view, toasts, background, nav, device_list,
  add_device_button, remove_device_button.
  As páginas vêm de page-*.ui e são registradas no AdwNavigationView "nav".
-->
<interface domain="buds-studio">
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.7"/>
  <object class="AdwApplicationWindow" id="window">
    <property name="title">Buds Studio</property>
    <property name="default-width">1040</property>
    <property name="default-height">820</property>
    <property name="width-request">360</property>
    <property name="height-request">480</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 760sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="GtkBox" id="background">
            <property name="orientation">vertical</property>
            <style>
              <class name="app-background"/>
            </style>
            <child>
              <object class="AdwNavigationSplitView" id="split_view">
                <property name="vexpand">True</property>
                <property name="min-sidebar-width">260</property>
                <property name="max-sidebar-width">320</property>
                <property name="show-content">True</property>
                <property name="sidebar">
                  <object class="AdwNavigationPage">
                    <property name="title" translatable="yes">Devices</property>
                    <property name="tag">devices</property>
                    <property name="child">
                      <object class="AdwToolbarView">
                        <child type="top">
                          <object class="AdwHeaderBar"/>
                        </child>
                        <property name="content">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <style>
                                  <class name="device-sidebar"/>
                                </style>
                                <child>
                                  <object class="GtkListBox" id="device_list">
                                    <property name="selection-mode">single</property>
                                    <style>
                                      <class name="navigation-sidebar"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="add_device_button">
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">list-add-symbolic</property>
                                        <property name="label" translatable="yes">Add new device</property>
                                      </object>
                                    </property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="device-sidebar-action"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="remove_device_button">
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">user-trash-symbolic</property>
                                        <property name="label" translatable="yes">Remove devices</property>
                                      </object>
                                    </property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="device-sidebar-action"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="content">
                  <object class="AdwNavigationPage">
                    <property name="title">Buds Studio</property>
                    <property name="tag">content</property>
                    <property name="child">
                      <object class="AdwNavigationView" id="nav"/>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
